# Copy to `.env` and fill in. `.env` is git-ignored and is used only by the
# local test path (infra/lambda_collector/local_run.py). In AWS these same
# names are set as Lambda environment variables.

# Free key from https://developer.wmata.com/ (sign in -> Products -> subscribe
# to the default tier -> copy the primary key).
WMATA_API_KEY=replace-me

# Destination archive. S3_PREFIX must end with "/".
S3_BUCKET=replace-me-bucket-name
S3_PREFIX=raw/

# Local test path only. When set, snapshots are written under this directory
# instead of S3 and no AWS credentials are needed. Leave unset/empty to write
# to S3. The Lambda must NEVER have this set.
LOCAL_OUTPUT_DIR=data/local
