# Copy to `.env` and fill in. `.env` is git-ignored and is used only by the
# local test path (infra/lambda_collector/local_run.py). In AWS these same
# names are set as Lambda environment variables.

# Free key from https://developer.wmata.com/ (sign in -> Products -> subscribe
# to the default tier -> copy the primary key).
WMATA_API_KEY=replace-me

# Destination archive. Both prefixes must end with "/".
S3_BUCKET=replace-me-bucket-name
S3_PREFIX=raw/

# Where daily static GTFS bundles land. This must NOT nest inside S3_PREFIX:
# that prefix has a 90-day expiry lifecycle rule, and because WMATA serves only
# the current bundle (rail's feed window is ~10 days) an expired bundle can never
# be re-fetched — the archive would permanently lose the ability to compute
# correct scheduled-vs-actual deltas for older data. config.py refuses to start
# if the two prefixes nest.
S3_STATIC_PREFIX=static/

# How many collection passes one invocation performs. Unset means 1, which with a
# 60-second EventBridge schedule gives a 60-second archive. Set to 2 for a 30-second
# cadence from a single schedule -- but note the waiting between passes is billed
# Lambda time (~$11/month), whereas two schedules offset by 30 seconds achieve the
# same cadence for free. See docs/polling-cadence.md.
POLLS_PER_INVOCATION=1

# Local test path only. When set, snapshots are written under this directory
# instead of S3 and no AWS credentials are needed. Leave unset/empty to write
# to S3. The Lambda must NEVER have this set.
LOCAL_OUTPUT_DIR=data/local
