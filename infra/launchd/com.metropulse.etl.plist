<?xml version="1.0" encoding="UTF-8"?>
<!--
  Daily ETL catch-up.

  launchd rather than cron, for one specific reason: cron simply skips a job whose
  scheduled time passed while the Mac was asleep, whereas launchd runs a missed
  StartCalendarInterval job at the next wake. That is a real difference on a laptop.

  It is still only a backstop. src/etl/catchup.py processes every outstanding service
  day rather than "yesterday", so nothing depends on a particular firing.

  __REPO_ROOT__ is substituted at install time; see runbook.txt, "Automated operation".
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.metropulse.etl</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO_ROOT__/scripts/run_etl_daily.sh</string>
    </array>

    <!--
      09:00 local, not 01:00. The service day closes at 04:00 UTC (midnight local), so
      any morning hour has complete data. Choosing a time the machine is usually awake
      means the job normally runs on schedule instead of relying on wake-catch-up.
    -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Do not run on login or on every reload; the schedule is the only trigger. -->
    <key>RunAtLoad</key>
    <false/>

    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__</string>

    <!--
      The wrapper writes its own timestamped log. These two catch anything that fails
      before the wrapper gets that far — a missing interpreter, a bad path — which is
      otherwise invisible.
    -->
    <key>StandardOutPath</key>
    <string>__REPO_ROOT__/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO_ROOT__/logs/launchd.err.log</string>

    <!-- One run at a time. A backlog catch-up can outlast the next firing. -->
    <key>AbandonProcessGroup</key>
    <false/>
</dict>
</plist>
